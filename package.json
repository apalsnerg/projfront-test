{
  "name": "projfront",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Web-based code editor for live collaborative coding created by Team 1 during the course Projekt webbprogrammering frontend at Blekinge Institute of Technology.",
  "scripts": {
    "test": "echo \"Implement later\" && exit 0",
    "dev": "vite",
    "build": "vite build",
    "lint:check": "npm run eslint:check && npm run stylelint:check",
    "lint:fix": "npm run eslint:fix && npm run stylelint:fix",
    "format:check": "npm run prettier:check",
    "format:fix": "npm run prettier:fix",
    "check": "npm run lint:check && npm run format:check",
    "fix": "npm run lint:fix && npm run format:fix",
    "eslint:check": "eslint . --max-warnings=0",
    "eslint:fix": "eslint . --fix",
    "stylelint:check": "stylelint \"**/*.{css,scss}\"",
    "stylelint:fix": "stylelint --fix \"**/*.{css,scss}\"",
    "prettier:check": "prettier --check src/",
    "prettier:fix": "prettier --write src/",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.2.4",
    "monaco-editor": "^0.53.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.5",
    "react-router": "^7.14.2",
    "react-router-dom": "^7.14.2",
    "socket.io-client": "^4.8.3",
    "stylelint-config-recommended": "^18.0.0",
    "tailwindcss": "^4.2.4",
    "y-monaco": "^0.1.6",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.30"
  },
  "devDependencies": {
    "@eslint/css": "^1.1.0",
    "@eslint/js": "^9.39.4",
    "@eslint/json": "^1.2.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "emnapi": "^1.10.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jest": "^30.3.0",
    "prettier": "^3.8.3",
    "stylelint": "^17.8.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.0.4"
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "singleQuote": false,
    "useTabs": false,
    "semi": true,
    "trailingComma": "all",
    "bracketSpacing": true,
    "arrowParens": "always",
    "endOfLine": "lf",
    "objectWrap": "preserve",
    "bracketSameLine": false,
    "singleAttributePerLine": true
  }
}
